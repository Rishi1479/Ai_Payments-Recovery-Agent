# ─── App ───────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=changeme-use-a-long-random-string

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/revenue_recovery
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/revenue_recovery

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── LLM ───────────────────────────────────────────────
GEMINI_API_KEY=your-google-gemini-api-key
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ─── LangSmith ─────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=ai-revenue-recovery-agent

# ─── Recovery Policies ─────────────────────────────────
MAX_RETRIES=3
MAX_CUSTOMER_MESSAGES=2
RECOVERY_WINDOW_DAYS=7
RETRY_COOLDOWN_HOURS=6

# ─── Batch Processing ──────────────────────────────────
BATCH_CONCURRENCY=20
LLM_CONCURRENCY=5
LLM_RATE_LIMIT_PER_SEC=5

# ─── Classification ────────────────────────────────────
MIN_CONFIDENCE_THRESHOLD=0.70

# ─── Mock Gateway ──────────────────────────────────────
MOCK_GATEWAY_SEED=42
